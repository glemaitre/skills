# Copy this file to `.env` and fill in the keys for the providers you
# will call:
#     cp .env.example .env
#
# tests/eval loads `.env` from the repo root via python-dotenv. Values
# already set in the shell take precedence. Model ids are not set here
# — they live in pixi.toml (`feature.eval.activation.env`).

# Default target/judge go through OpenRouter (LiteLLM `openrouter/...`).
OPENROUTER_API_KEY=sk-or-...

# Only needed if you switch pixi env vars to native provider ids:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
