# Copy this file to `.env` and fill in your real key:
#     cp .env.example .env
#
# The pytest-skill-eval plugin auto-loads `.env` from the repo root
# at session start (via python-dotenv). Values already set in the
# shell environment take precedence.

# Required: Anthropic API key used both for the model under test and
# the LLM judge. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-...
